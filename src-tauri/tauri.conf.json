{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Teddy Mail",
  "version": "0.3.2",
  "identifier": "studio.triskell.teddy-mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teddy Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Calm, sovereign, customizable mail client",
    "longDescription": "Teddy Mail: calm, sovereign, deeply customizable. Multi-account IMAP/JMAP, on-device classification, tracker blocking, encrypted local store."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jordan-Bourillot/teddy-mail/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQTZBNzI0Q0UwRjkxRTUKUldUbGtRL09KS2VtWW1wOUtTY2dSTEdFVzZsZE1EVUlYNXp4RmRpelgwWHNlYWRQV1pwZnE1VE4K"
    }
  }
}
